# =============================================================================
# .env.example — Video Knowledge Lab
#
# ESTE arquivo E versionado. O .env real NUNCA e.
#
# Ele existe para o contrato de portabilidade: quem clonar o projeto em outra
# maquina precisa saber QUAIS variaveis existem e o que significam, sem nunca
# ver os valores. Documente o significado; deixe o valor vazio ou fake.
#
# Copiar com:  Copy-Item .env.example .env
# =============================================================================

# Caminho da pasta de trabalho (varia por maquina — nunca fixar no codigo)
# WORK_DIR=

# Interpretador Python a usar (a maquina tem 3.12 e 3.13; nao deixar implicito)
# PYTHON_EXE=

# --- Servicos externos (preencher so o que o projeto realmente usa) ----------
# NOTION_TOKEN=
# N8N_WEBHOOK_URL=
# GITHUB_TOKEN=

# Regra: se uma variavel some daqui, quem clonar nao consegue rodar o projeto.
# Adicionar aqui e parte de adicionar a variavel, nao um passo separado.
